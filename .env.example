# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота — получить у @BotFather в Telegram
TG_BOT_TOKEN=ВАШ_ТОКЕН_СЮДА

# ── Google Gemini (бесплатно) ────────────────────────────────────────────────
# API-ключ — получить на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ВАШ_КЛЮЧ_GEMINI_СЮДА

# Модель Gemini
# gemini-3.5-flash — хороший баланс скорости и качества
# gemini-3.5-flash-lite — быстрая и лёгкая
# gemini-flash-latest — всегда самая свежая flash-модель
GEMINI_MODEL=gemini-3.5-flash

# ── Настройки бота ──────────────────────────────────────────────────────────
# Максимум пар "вопрос → ответ" в истории (старые забываются)
MAX_HISTORY=20

# Системный промпт (стиль общения ИИ)
SYSTEM_PROMPT=Ты — дружелюбный, полезный и умный ИИ-помощник в Telegram. Отвечай кратко, по делу, на том же языке, на котором к тебе обратились.
